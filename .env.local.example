# Public client values
NEXT_PUBLIC_CONVEX_URL=https://wary-hornet-265.eu-west-1.convex.cloud
# Optional local fallback only. Production reads TURNSTILE_SITE_KEY at request time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# The approved public Mereka M. Set false only for an emergency visual rollback.
NEXT_PUBLIC_BRAND_MOTION_ENABLED=true

# Server-only values
CONVEX_URL=https://wary-hornet-265.eu-west-1.convex.cloud
CONVEX_INGEST_SECRET=
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_MODEL_CANDIDATE=gpt-realtime-2.1
# LLM judge for voice evals (script + POST /api/admin/evals). gpt-5.6-luna recommended for quality.
EVAL_JUDGE_MODEL=gpt-4o-mini
# Score conversations automatically when a call closes with turns (default on; set false to disable).
EVAL_AUTO_ON_CLOSE=true
VOICE_MODEL_CELL=control
VOICE_EMAIL_CAPTURE_MODE=strict
VOICE_REASONING_CELL=low
OPENAI_REALTIME_VOICE=coral
OPENAI_REALTIME_SPEED=1.28
VOICE_RUNTIME_PROFILE=baseline
# Optional: override session input transcription (e.g. gpt-realtime-whisper, gpt-4o-mini-transcribe)
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Optional: tune voice session policy without a code deploy
VOICE_SESSION_DAILY_LIMIT=80
VOICE_MAX_DURATION_MS=600000
VOICE_IDLE_TIMEOUT_MS=20000
VOICE_IDLE_GOODBYE_GRACE_MS=6000
# QA-only voice picker. Keep false for baseline/candidate evidence campaigns.
VOICE_VARIANT_PICKER=false
REDIS_URL=
# Explicit abuse-policy cell. `relaxed` keeps Redis rate limits active without
# requiring the currently disabled Turnstile client challenge.
TURNSTILE_ENFORCEMENT=relaxed
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
IP_HASH_SECRET=
# Interactive review login and its principal embedded into signed admin sessions.
# ADMIN_REVIEW_PASSWORD_HMAC is HMAC-SHA256("oriental-admin-password:v1\0" + password)
# keyed by ADMIN_REVIEW_TOKEN; never store the plaintext password in this file.
ADMIN_REVIEW_TOKEN=
ADMIN_REVIEW_PASSWORD_HMAC=
ADMIN_REVIEW_ROLE=operator
ADMIN_REVIEW_ACTOR=Oriental intake operator
# Bearer-only, least-privilege credentials for scheduled maintenance and privacy deletion.
OPS_AUTOMATION_TOKEN=
PRIVACY_ADMIN_TOKEN=
COOLIFY_ORIENTAL_APPLICATION_UUID=mtrl2z6a7zvoyevxvufpntij

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional build/CI-only source-map upload; avoid Coolify runtime injection.
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=development

AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_ADDRESS=oriental@mereka.io
SES_REPLY_TO=team@mereka.io
# Optional: copy full owner lead emails to a shared team inbox. No default fallback is applied.
TEAM_NOTIFICATION_EMAIL=
# Optional: additional owner-email recipients, separated by comma/space/semicolon.
TEAM_NOTIFICATION_CC_EMAILS=
SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Preferred Slack delivery uses a bot token plus explicit channel id.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=C01AVSGACFN
OPS_ALERT_SLACK_CHANNEL_ID=C01AVSGACFN
# Optional fallback only when bot-token delivery is not configured.
SLACK_WEBHOOK_URL=
OPS_ALERT_SLACK_WEBHOOK_URL=

# Production ClickUp lead mirror. CLICKUP_LIST_ID may be a raw id or a list URL.
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=

OWNER_TENANCY=chewi@mereka.io
OWNER_EDUCATION=lala@mereka.io
OWNER_PROGRAMME=jey@mereka.io
OWNER_TECHNOLOGY=gurpreet@mereka.io
OWNER_COMMUNITY=ambika@mereka.io
OWNER_OTHER=nadia@mereka.io

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Served to the browser via /api/client-config at runtime
# (rotatable without rebuild). Loads only when set; admin routes are never tracked.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification token (content attribute only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
