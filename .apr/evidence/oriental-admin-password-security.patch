+}
+
+const adminRoutePaths = discoverAdminRoutePaths();
+const productionRootPaths = [
+  ...new Set([
+    ...parsedTsConfig.fileNames.map((path) => relative(process.cwd(), path)),
+    ...globSync(`**/*.${sourceExtensions}`),
+  ]),
+]
+  .filter(isProductionRootPath)
