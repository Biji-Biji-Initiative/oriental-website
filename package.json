{
  "name": "oriental-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": "8.5.31",
      "sharp@0.34.5": "0.35.5",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12"
    }
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "audit:prod": "pnpm audit --prod --audit-level=high --json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "env NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test tests/e2e/admin-session-review.spec.ts",
    "test:performance": "tsx scripts/run-page-performance.ts",
    "convex:codegen": "convex codegen",
    "convex:deploy": "convex deploy",
    "convex:backfill:voice-session-lifecycle": "tsx scripts/run-command-with-deadline.ts --timeout-ms 600000 -- pnpm exec tsx scripts/backfill-voice-session-lifecycle.ts",
    "check-secrets": "tsx scripts/check-secrets.ts",
    "backfill:clickup": "tsx scripts/backfill-clickup-leads.ts",
    "eval:voice": "tsx scripts/eval-voice.ts",
    "smoke:staging:intake": "tsx scripts/smoke-staging-intake.ts",
    "smoke:staging:voice": "tsx scripts/smoke-staging-voice.ts",
    "release:preflight": "pnpm lint && pnpm typecheck && tsx scripts/run-release-tests.ts && env NODE_ENV=production pnpm check-secrets && pnpm build && tsx scripts/release-preflight.ts",
    "release:verify:voice-cell": "tsx scripts/release-preflight.ts --voice-cell-only",
    "release:verify:orphan-sweep": "tsx scripts/run-command-with-deadline.ts --timeout-ms 15000 -- pnpm exec tsx scripts/verify-orphan-sweep.ts",
    "release:verify:admin": "tsx scripts/verify-admin-release-proof.ts",
    "release:deploy:production": "tsx scripts/deploy-coolify-production.ts",
    "release:verify": "tsx scripts/release-verify.ts",
    "ops:status": "tsx scripts/ops-status.ts",
    "voice:debug": "tsx scripts/voice-debug.ts",
    "local:ngrok": "tsx scripts/local-ngrok.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1156.0",
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.2",
    "@sentry/nextjs": "^10.76.2",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.48.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "openai": "^6.49.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.2",
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^149.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "semver": "7.8.5",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "yaml": "2.9.1"
  }
}
